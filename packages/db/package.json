{
  "name": "@andal/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/scripts/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/scripts/seed.ts",
    "user": "node --env-file-if-exists=../../.env --import tsx src/scripts/user.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@andal/authz": "workspace:*",
    "@andal/editor": "workspace:*",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@node-rs/argon2": "^2.2.2",
    "kysely": "^0.28.0",
    "pg": "^8.16.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  }
}
