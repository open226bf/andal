# Andal en production: copier en deploy/.env, remplir, puis
#   docker compose -f deploy/compose.yaml --env-file deploy/.env up -d
# Générez chaque secret avec: openssl rand -base64 32

# Domaine public (enregistrement DNS A/AAAA vers ce serveur). Caddy obtient le certificat tout seul.
ANDAL_DOMAIN=docs.example.com
# Version des images (une étiquette de release, ou latest).
ANDAL_VERSION=latest

# Base de données.
POSTGRES_PASSWORD=

# Stockage des fichiers (RustFS du compose par défaut, ou tout S3: S3_ENDPOINT, S3_REGION).
S3_ACCESS_KEY=andal
S3_SECRET_KEY=
S3_BUCKET=andal
UPLOAD_MAX_MB=25

# Connexion: mot de passe local (true/false) et SSO OpenID Connect optionnel.
AUTH_PASSWORD=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=SSO
OIDC_AUTO_CREATE=false
# Groupes du fournisseur à chaque connexion SSO (claim « groups », souvent). Okta: OIDC_GROUPS_SCOPE=groups.
OIDC_GROUPS_CLAIM=
OIDC_GROUPS_SCOPE=

# Emails (invitations, mot de passe oublié, notifications non lues).
SMTP_URL=smtp://utilisateur:motdepasse@smtp.example.com:587
MAIL_FROM="Andal <docs@example.com>"
NOTIFY_EMAIL_DELAY=300

TRASH_RETENTION_DAYS=30

# Ports publiés (80 et 443 en production). Pour un essai local à côté d'autres
# services: HTTP_PORT=58880, HTTPS_PORT=58443, ANDAL_ORIGIN=https://localhost:58443
HTTP_PORT=80
HTTPS_PORT=443

# Intégrations (Administration > Intégrations pour les webhooks).
# Webhooks vers des adresses privées (réseau interne): refusés par défaut.
WEBHOOK_ALLOW_PRIVATE=false
# Délai de regroupement des « page modifiée », en secondes.
WEBHOOK_UPDATE_DELAY=120
# Aperçus des liens GitHub (sans jeton: dépôts publics, 60 requêtes par heure) et Jira.
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Assistant (questions sur la documentation). Réglable aussi dans Administration > Assistant.
# anthropic: Claude (AI_API_KEY); openai: toute API compatible, locale comprise (Ollama, LM Studio, vLLM).
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=

# Limite de débit, par minute: lectures et écritures d'une session ou d'un jeton, requêtes sans session par IP.
RATE_LIMIT=true
RATE_LIMIT_READS=600
RATE_LIMIT_WRITES=120
RATE_LIMIT_ANONYMOUS=120
# Proxys dont on croit X-Forwarded-For. Par défaut la machine et les réseaux privés (Caddy du compose).
# Derrière un autre proxy ou un équilibreur: son adresse ou son réseau (ex. 10.0.0.0/8).
TRUST_PROXY=loopback,uniquelocal
