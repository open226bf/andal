{
  "name": "@andal/collab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:readonly": "tsx --env-file-if-exists=../../.env scripts/readonly-check.ts",
    "check:live-access": "tsx --env-file-if-exists=../../.env scripts/live-access-check.ts"
  },
  "dependencies": {
    "@andal/authz": "workspace:*",
    "@andal/db": "workspace:*",
    "@andal/editor": "workspace:*",
    "@hocuspocus/server": "^3.2.0",
    "@tiptap/y-tiptap": "^3.0.0",
    "bullmq": "^5.56.0",
    "ioredis": "^5.6.0",
    "kysely": "^0.28.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^3.2.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
