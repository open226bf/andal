# Copier en .env puis lancer `pnpm infra:up`.
# Valeurs de développement uniquement: ne jamais les réutiliser ailleurs.

POSTGRES_PASSWORD=calepin_dev
DATABASE_URL=postgres://calepin:calepin_dev@127.0.0.1:55432/calepin
VALKEY_URL=redis://127.0.0.1:56379

# Pas de secret de session: le cookie porte un identifiant aléatoire de 256 bits,
# et Valkey n'en stocke que l'empreinte SHA-256.

# Connexion par identifiant (ou email) et mot de passe. Activée par défaut;
# `false` pour n'autoriser que le SSO.
AUTH_PASSWORD=true

# Mot de passe des comptes de démo créés par `pnpm db:seed`.
DEMO_PASSWORD=calepin-demo-2026

# SSO OpenID Connect, optionnel: laissez OIDC_ISSUER vide pour le désactiver.
# Pour essayer avec le Keycloak local: `docker compose --profile sso up -d`,
# puis décommentez ces lignes et relancez l'API.
# OIDC_ISSUER=http://localhost:58080/realms/calepin
# OIDC_CLIENT_ID=calepin
# OIDC_CLIENT_SECRET=calepin-oidc-dev-secret
# OIDC_LABEL=Keycloak
# Crée un compte Andal à la première connexion d'une identité inconnue.
# Sinon, seules les identités dont l'email vérifié correspond à un compte existant entrent.
# OIDC_AUTO_CREATE=false

# Envoi des emails (invitations, mot de passe oublié). En dev, Mailpit les
# attrape: http://localhost:58025. Sans SMTP_URL, l'admin reçoit le lien à transmettre.
SMTP_URL=smtp://127.0.0.1:51025
MAIL_FROM="Andal <andal@andal.test>"
# Délai avant l'email d'une notification restée non lue (secondes). 300 par
# défaut; court en dev pour voir passer les emails dans Mailpit.
NOTIFY_EMAIL_DELAY=30

# Jours passés à la corbeille avant suppression définitive (30 par défaut).
TRASH_RETENTION_DAYS=30

# Fichiers envoyés (images, pièces jointes): tout stockage compatible S3.
# En dev, le RustFS du docker compose. Sans S3_BUCKET, l'envoi est désactivé.
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=andal
S3_ACCESS_KEY=calepin-dev
S3_SECRET_KEY=calepin-dev-secret
# Taille maximale d'un fichier envoyé (Mo).
UPLOAD_MAX_MB=25
# Taille maximale d'une archive à importer: Markdown, Notion, Confluence (Mo).
IMPORT_MAX_MB=200
# Export PDF (service gotenberg du docker-compose).
GOTENBERG_URL=http://localhost:53000
# Liens publics en lecture, sans compte (false: interdits, et ceux qui existent sont coupés).
PUBLIC_LINKS=true

API_PORT=3001
COLLAB_PORT=3002
WEB_ORIGIN=http://localhost:5173

RUSTFS_ACCESS_KEY=calepin-dev
RUSTFS_SECRET_KEY=calepin-dev-secret
KEYCLOAK_ADMIN_PASSWORD=calepin_dev

# Webhooks: autoriser les envois vers le réseau interne (Mattermost sur le LAN).
# Laissé à false en production, sauf besoin: c'est la protection contre le SSRF.
# En dev, true pour que les tests reçoivent les webhooks sur 127.0.0.1.
WEBHOOK_ALLOW_PRIVATE=true
# Délai (secondes) avant d'annoncer « page modifiée »: une rafale de modifications = un message.
WEBHOOK_UPDATE_DELAY=120

# Aperçu des liens GitHub et Jira au survol (facultatif).
# Sans GITHUB_TOKEN: dépôts publics seulement, 60 requêtes par heure.
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Synchro Git: dépôts sur le réseau interne ou en file:// (forge interne, tests).
# À laisser à false en production sauf forge interne. En dev, true pour les tests.
GIT_ALLOW_LOCAL=true

# Assistant de questions-réponses (facultatif; les admins peuvent aussi le régler dans l'interface).
# AI_PROVIDER=anthropic: Claude, clé dans AI_API_KEY ou ANTHROPIC_API_KEY (modèle par défaut: claude-opus-5-5).
# AI_PROVIDER=openai: toute API compatible, locale comprise (Ollama: AI_BASE_URL=http://127.0.0.1:11434/v1, AI_MODEL=llama3.1).
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=

# Groupes du SSO à chaque connexion (le realm de dev envoie le claim « groups »).
OIDC_GROUPS_CLAIM=groups
OIDC_GROUPS_SCOPE=

# Limite de débit, par minute (voir README). En dev, les suites de bout en bout se connectent souvent depuis la même adresse.
RATE_LIMIT=true
RATE_LIMIT_READS=600
RATE_LIMIT_WRITES=120
RATE_LIMIT_ANONYMOUS=600
TRUST_PROXY=loopback,uniquelocal
